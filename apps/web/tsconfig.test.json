{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "outDir": "./dist-test",
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@pauselink/types": ["../../packages/types/src/index.ts"]
    }
  },
  "include": ["lib/analyzer/**/*.ts", "tests/**/*.ts"]
}
